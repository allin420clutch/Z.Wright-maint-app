rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /workOrders/{woId} {
      allow read, write: if true;
    }

    match /equipment/{equipmentId} {
      allow read, write: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Is the user an admin according to their stored role?
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isValidUser(data) {
      return data.keys().hasAll(["email", "role", "createdAt"]) 
        && data.keys().size() == 3 
        && data.email is string 
        && data.email.size() <= 256
        && data.role in ["technician", "supervisor", "admin"]
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Users can be created by admins, or perhaps no direct creation
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if false; // immutable for now or only admin
      allow delete: if false;
    }
  }
}
